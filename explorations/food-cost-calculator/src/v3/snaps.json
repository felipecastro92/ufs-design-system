{
 "banner": "<div class=\"ufs-fcc-banner\">\n          <img class=\"ufs-fcc-banner__icon\" src=\"../../handover/icons/food-calculator.svg\" alt=\"\" width=\"40\" height=\"40\">\n          <div class=\"ufs-fcc-banner__body\">\n            <h3 class=\"ufs-fcc-banner__title\">Calculate your food cost easily</h3>\n            <p class=\"ufs-fcc-banner__desc\">Save your recipe calculations as a PDF and use them on the go</p>\n            <button type=\"button\" class=\"btn btn-primary\" aria-haspopup=\"dialog\" tabindex=\"-1\">Calculate the cost of this recipe</button>\n          </div>\n        </div>",
