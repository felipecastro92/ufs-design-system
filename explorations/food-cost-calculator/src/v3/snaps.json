 "ft_incomplete": "<div class=\"ufs-fcc__ft\">\n      <dl class=\"ufs-fcc__totals\">\n        <div><dt>Total cost</dt><dd>1,60 €</dd></div>\n        <div><dt>Per serving</dt><dd>0,16 €</dd></div>\n        <div><dt>Food cost</dt><dd><span>–</span><span class=\"ufs-fcc__status\" hidden=\"\"></span></dd></div>\n      </dl>\n      <p class=\"ufs-fcc__ft-note\">Add prices for 7 more ingredients for a complete total.</p>\n    </div>",
